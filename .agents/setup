#!/usr/bin/env bash
set -euo pipefail

printf '[setup] Checking Node.js\n'
node -e 'const [major, minor] = process.versions.node.split(".").map(Number); if (major < 20 || (major === 20 && minor < 19)) { throw new Error("Vite requires Node.js 20.19 or newer") }'

printf '[setup] Enabling the pinned pnpm version\n'
corepack enable

printf '[setup] Installing dependencies from pnpm-lock.yaml\n'
time pnpm install --frozen-lockfile
